#!/bin/sh

echo "Running all tests before push..."

pnpm test:all
TEST_EXIT_CODE=$?
if [ $TEST_EXIT_CODE -ne 0 ]; then
  echo "Unit tests failed with code $TEST_EXIT_CODE"
  exit $TEST_EXIT_CODE
fi

pnpm test:e2e
E2E_EXIT_CODE=$?
if [ $E2E_EXIT_CODE -ne 0 ]; then
  echo "E2E tests failed with code $E2E_EXIT_CODE"
  exit $E2E_EXIT_CODE
fi

echo "All tests passed!"
exit 0
