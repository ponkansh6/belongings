{
  "name": "belongings",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "^24.22.0",
    "pnpm": "^11.9.0"
  },
  "scripts": {
    "preinstall": "pnpm dlx only-allow pnpm",
    "tsgo": "tsgo",
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "test": "vitest run --project logic",
    "test:watch": "vitest --project logic",
    "test:ui": "vitest run --project ui --reporter=verbose",
    "test:all": "vitest run",
    "test:coverage:report": "vitest run --coverage --coverage.reporter=json-summary",
    "test:coverage:check": "pnpm run test:coverage:report && node scripts/check-coverage-gate.mjs",
    "test:e2e": "playwright test",
    "lint": "eslint --cache",
    "lint:fast": "oxlint --ignore-pattern 'tests/**' --ignore-pattern 'scripts/ts_converters/**' --nextjs-plugin --react-plugin --react-perf-plugin",
    "check:deps": "depcheck",
    "format:fast": "oxfmt --write .",
    "type-check": "tsc --noEmit",
    "type-check:fast": "tsgo --noEmit",
    "security-check": "pnpm run security-check:dev && pnpm run security-check:commercial",
    "security-check:dev": "pnpm audit --dev --audit-level=high && secretlint \"**/*\"",
    "security-check:commercial": "pnpm audit --prod --audit-level=high",
    "mem": "node ~/.config/opencode/start-mem-server.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "framer-motion": "^12.42.0",
    "next": "^16.4.2",
    "papaparse": "^5.6.0",
    "postcss": "^8.5.30",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.2.8",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "4.1.12",
    "@vitest/ui": "^4.1.12",
    "arquero": "^8.0.3",
    "bun": "^1.3.14",
    "bun-types": "^1.3.14",
    "depcheck": "^1.4.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.11.2",
    "husky": "^9.1.7",
    "iconv-lite": "^0.7.3",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.78.0",
    "prettier": "^3.9.6",
    "secretlint": "13.0.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
